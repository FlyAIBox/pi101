# Never commit a real key. Export it in the shell before running a live lab.
DEEPSEEK_API_KEY=

# Optional. When omitted, pi101 selects the first tool-capable DeepSeek model
# in pi v0.85.1's pinned catalog.
PI101_MODEL_ID=

# Set to 1 only for local debugging. Default traces omit prompt/tool payloads.
PI101_TRACE_CONTENT=0
